; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PokeRPG"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.0")
config/icon="res://assets/android/app_icon_512.png"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.05, 0.11, 0.19, 1)

[autoload]

SaveManager="*res://scripts/save_manager.gd"
GameState="*res://scripts/game_state.gd"
InventoryManager="*res://scripts/inventory_manager.gd"
AudioManager="*res://scripts/audio_manager.gd"

[display]

window/size/viewport_width=360
window/size/viewport_height=640
window/size/window_width_override=360
window/size/window_height_override=640
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input_devices]

pointing/android/enable_pan_and_scale_gestures=true

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
